{
  "name": "nextile",
  "version": "2026.11.1",
  "description": "NexTile - Tiling Extension for GNOME",
  "main": "extension.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "prettier --list-different \"./**/*.{js,jsx,ts,tsx,json}\"",
    "lint:e2e": "eslint tests/e2e/framework",
    "lint:src": "eslint lib extension.js prefs.js",
    "pretypecheck": "make --no-print-directory metadata",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "husky install",
    "format": "prettier --write \"./**/*.{js,jsx,ts,tsx,json}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fresp/nextile.git"
  },
  "keywords": [
    "gnome",
    "nextile",
    "tiling",
    "javascript",
    "gnome-shell"
  ],
  "author": "Jose Maranan",
  "contributors": [
    "Benny Powers <web@bennypowers.com>"
  ],
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/fresp/nextile/issues"
  },
  "homepage": "https://github.com/fresp/nextile#readme",
  "devDependencies": {
    "@girs/adw-1": "^1.4.2-3.2.7",
    "@girs/clutter-13": "^13.0.0-3.2.7",
    "@girs/gdk-4.0": "^4.0.0-3.2.7",
    "@girs/gio-2.0": "^2.78.0-3.2.7",
    "@girs/gjs": "^3.2.7",
    "@girs/gnome-shell": "45.0.0-beta9",
    "@girs/gobject-2.0": "^2.78.0-3.2.7",
    "@girs/gtk-4.0": "^4.12.4-3.2.7",
    "@girs/meta-13": "^13.0.0-3.2.7",
    "@girs/st-13": "^13.0.0-3.2.7",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown",
    "**/*.{js,jsx}": "vitest related --run",
    "lib/**/*.js": "eslint",
    "{extension,prefs}.js": "eslint",
    "tests/e2e/framework/*.js": "eslint",
    "tests/e2e/**/*.py": [
      "ruff format",
      "ruff check --fix"
    ]
  }
}
